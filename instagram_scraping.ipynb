   "source": [
    "# Instagram follower crawler\n",
    "The maintained implementation is `crawler.py`. Configure a local `.env` and run only when you intend to start a browser session.\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "from crawler import main\n\n",
    "# Enable explicitly to start a browser session.\n",
    "RUN_CRAWLER = False\n",
    "if RUN_CRAWLER:\n",
    "    main()\n"
   ],
